# Choose ONE of the following network setups by filling the relevant variables.

# --- Network / RPC / Relay ---
# NETWORK=sepolia or mainnet
NETWORK=sepolia

# JSON-RPC endpoint for the selected network
ETHEREUM_RPC_URL=

# Flashbots relay endpoint
# Mainnet: https://relay.flashbots.net
# Sepolia: https://relay-sepolia.flashbots.net
FLASHBOTS_RELAY_URL=https://relay-sepolia.flashbots.net

# How many future blocks to target each new block (higher increases inclusion chance on testnets)
BLOCKS_TO_TARGET=10

# Priority fee in gwei (added on top of baseFee)
PRIORITY_FEE_GWEI=31

# --- Required for both ---
PRIVATE_KEY_EXECUTOR=
PRIVATE_KEY_SPONSOR=
RECIPIENT=
FLASHBOTS_RELAY_SIGNING_KEY=

# --- Engine selection ---
# ENGINE=approval721 or transfererc20
ENGINE=approval721

# For ENGINE=approval721: comma-separated ERC721 contract addresses on the selected network
APPROVAL721_CONTRACTS=

# For ENGINE=transfererc20: ERC20 token contract address on the selected network
ERC20_TOKEN_ADDRESS=
